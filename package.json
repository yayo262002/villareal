{
  "name": "comercializadora-villareal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "verificar": "npm run typecheck && npm run lint && npm run test",
    "copia": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/copia.ts",
    "prueba:local": "node scripts/prueba-extremo.mjs",
    "prueba:web": "node scripts/prueba-extremo.mjs --url=https://villareal-green.vercel.app"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
